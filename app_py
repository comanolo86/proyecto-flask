    DEBUG = True  # Permite ver errores detallados mientras programas
    SECRET_KEY = 'servidor_seguro_123'

app.config.from_object(MiConfiguracion)

@app.route('/home') # Esta es la ruta
def pagina_inicio():
    # Si todo sale bien, Flask devuelve el código 200 automáticamente
    return "Servidor Flask funcionando correctamente", 200

@app.route('/empleado/<int:id_empleado>', methods=['GET', 'PUT', 'PATCH'])
def gestionar_empleado(id_empleado):
    if request.method == 'GET':
        return f"Viendo datos del empleado número {id_empleado}"

    if request.method in ['PUT', 'PATCH']:
        # Aquí es donde el directivo "sobrescribe" o actualiza datos
        return f"Datos del empleado {id_empleado} actualizados en la base de datos", 200

@app.route('/rastrear')
def rastrear():
    # 'access_route' contiene la lista de IPs de los proxies y el cliente
    ip_cliente = request.access_route[0]
    return f"Tu IP de origen es: {ip_cliente}"
